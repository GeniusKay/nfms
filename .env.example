# NFMS-FIP application
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=nfms-fip.kenyaforestservice.org,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://nfms-fip.kenyaforestservice.org,http://localhost,http://127.0.0.1

# PostgreSQL / PostGIS
POSTGRES_DB=nfms_fip
POSTGRES_USER=nfms
POSTGRES_PASSWORD=replace-with-a-strong-password

# File/object storage
MINIO_ROOT_USER=nfmsminio
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
S3_BUCKET=nfms-fip
S3_REGION=us-east-1
MAX_UPLOAD_MB=500

# GeoServer
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=replace-with-a-strong-geoserver-password
GEOSERVER_SAMPLE_DATA=NO

# Django / Celery
DEMO_PASSWORD=ChangeMe123!
CELERY_CONCURRENCY=2
GUNICORN_WORKERS=3

# Optional administration tools
PGADMIN_DEFAULT_EMAIL=admin@nfms.local
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password
